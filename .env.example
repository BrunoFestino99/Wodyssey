# Optional overrides for npm run dev. Without them, the runner starts local PostgreSQL
# and captures email in the local inbox. Never use these local defaults in production.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/wodyssey
# SMTP_URL=smtp://user:password@127.0.0.1:1025
# EMAIL_FROM=Wodyssey <accounts@example.test>
# PORT=3000
# WEB_PORT=5173
# LOCAL_POSTGRES_PORT=55432
