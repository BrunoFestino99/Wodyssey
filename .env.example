# Optional overrides for npm run dev. Without them, the runner uses the Docker Compose
# PostgreSQL (start it with npm run dev:db) and captures email in the local inbox.
# Never use these local defaults in production.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/wodyssey
# SMTP_URL=smtp://user:password@127.0.0.1:1025
# EMAIL_FROM=Wodyssey <accounts@example.test>
# Ports, also used by docker-compose.yml.
# PORT=3000
# WEB_PORT=5173
# POSTGRES_PORT=5432
